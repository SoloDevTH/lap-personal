{
  "productName": "Lap",
  "version": "0.3.2",
  "identifier": "com.julyx10.lap",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../src-vite build",
    "beforeDevCommand": "pnpm --dir ../src-vite dev",
    "devUrl": "http://localhost:3580",
    "frontendDist": "../src-vite/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost http://thumb.localhost https://thumb.localhost http://preview.localhost https://preview.localhost https://tile.openstreetmap.org https://server.arcgisonline.com https://*.tianditu.gov.cn",
        "media-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost http://thumb.localhost https://thumb.localhost http://preview.localhost https://preview.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURES/**",
          "$VIDEOS/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Graphics and Design",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/*": "models",
      "resources/ffmpeg/*": "ffmpeg"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/julyx10/lap/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMEQ0QzM2RTRDOUNEMjUKUldRbHpjbmtOa3dOVXlBYm0rYk9lY2FtVGpzWTJ2NkRqdUtSOEN4eUxwRlVTaUlVbkJ4aHhQS3gK"
    }
  }
}
